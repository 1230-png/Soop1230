# 로컬 개발
DATABASE_URL=postgresql+asyncpg://shorts:shorts@localhost:5432/shorts

# 배포 (Neon 예시) — 반드시 +asyncpg 를 붙일 것
# DATABASE_URL=postgresql+asyncpg://user:pw@ep-xxx.neon.tech/shorts?ssl=require

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# 피드백 루프 판정 기준 (1% = 0.01)
FEEDBACK_MIN_VIEWS=500
FEEDBACK_LIKE_RATIO_THRESHOLD=0.01
FEEDBACK_MIN_SAMPLES=3

# 렌더링
HOOK_SEC=3.0
HOOK_CUT_SEC=0.5
PEXELS_API_KEY=

# YouTube (무료 할당량)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
